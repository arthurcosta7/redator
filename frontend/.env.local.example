# ═══════════════════════════════════════════════════════════════
# REDATOR — Variáveis de Ambiente do Frontend
# ═══════════════════════════════════════════════════════════════
# Copie este arquivo para .env.local e preencha os valores

# URL da API backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Stripe (chave pública — pode ficar no frontend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Nome da aplicação
NEXT_PUBLIC_APP_NAME=Redator
# Segredo apenas do servidor Next.js, igual ao do backend. Não usar NEXT_PUBLIC_.
REFERRAL_CLICK_SECRET=
