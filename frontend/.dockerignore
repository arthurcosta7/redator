# Variáveis locais não devem ser incorporadas ao bundle ou às camadas da imagem.
.env
.env.*
!.env.example
!.env.local.example

# Dependências e artefatos são recriados durante o build.
node_modules/
.next/
out/
coverage/
playwright-report/
test-results/
blob-report/
.vitest/
*.tsbuildinfo
npm-debug.log*

# Suítes e configurações de teste não participam do build Next.js.
tests/
playwright.config.ts
vitest.config.mts

# Metadados locais.
.git/
.gitignore
.dockerignore
.github/
.vscode/
.idea/
