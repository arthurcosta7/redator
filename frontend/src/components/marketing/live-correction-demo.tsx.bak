"use client";

import { useEffect, useState } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { Check, Sparkles } from "lucide-react";

/* â”€â”€â”€ RedaÃ§Ã£o exemplo (com marcadores para grifar) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
// Cada trecho tem tipo: "ok" (verde) ou "fix" (vermelho) + tooltip
const ESSAY_SEGMENTS = [
  { text: "Segundo dados do IBGE (2023), ", type: "ok", tip: "Argumento de autoridade â€” uso correto de dado." },
  { text: "o Brasil ocupa a 79Âª posiÃ§Ã£o no ranking mundial de educaÃ§Ã£o.", type: "neutral" },
  { text: " ", type: "neutral" },
  { text: "EntÃ£o, Ã© necessÃ¡rio que o governo tome providÃªncias imediatas.", type: "fix", tip: "Conectivo inadequado para iniciar conclusÃ£o â€” sugere causa onde nÃ£o hÃ¡." },
  { text: " ", type: "neutral" },
  { text: "A violÃªncia e a desigualdade social sÃ£o fatores que agravam esse cenÃ¡rio,", type: "ok", tip: "Boa contextualizaÃ§Ã£o do tema â€” sustenta o argumento." },
  { text: " ", type: "neutral" },
  { text: "tornando urgente a reflexÃ£o sobre polÃ­ticas pÃºblicas eficazes...", type: "fix", tip: "RepertÃ³rio genÃ©rico. Trocar por dado concreto (Ã­ndice, lei, autor)." },
];

const COMPETENCIES = [
  { label: "C1 Â· Linguagem formal", score: 160, color: "bg-accent" },
  { label: "C2 Â· Desenvolvimento do tema", score: 160, color: "bg-accent" },
  { label: "C3 Â· ArgumentaÃ§Ã£o", score: 120, color: "bg-amber-600" },
  { label: "C4 Â· CoesÃ£o e coerÃªncia", score: 120, color: "bg-amber-600" },
  { label: "C5 Â· Proposta de intervenÃ§Ã£o", score: 120, color: "bg-amber-600" },
];

const FINAL_SCORE = 680;

/* â”€â”€â”€ Hook: ciclo de 12s em 5 fases â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
type Phase = "typing" | "analyzing" | "highlighting" | "scoring" | "reveal";

const PHASE_DURATION: Record<Phase, number> = {
  typing: 3200,
  analyzing: 1200,
  highlighting: 2800,
  scoring: 2400,
  reveal: 2400,
};

export function LiveCorrectionDemo() {
  const [phase, setPhase] = useState<Phase>("typing");
  const [typedCount, setTypedCount] = useState(0);
  const [highlightedCount, setHighlightedCount] = useState(0);
  const [scoredCount, setScoredCount] = useState(0);
  const [activeTip, setActiveTip] = useState<number | null>(null);

  const fullText = ESSAY_SEGMENTS.map((s) => s.text).join("");
  const totalChars = fullText.length;

  // SequÃªncia principal: 5 fases em loop
  useEffect(() => {
    let timer: ReturnType<typeof setTimeout>;

    if (phase === "typing") {
      // DigitaÃ§Ã£o rÃ¡pida
      if (typedCount < totalChars) {
        timer = setTimeout(() => setTypedCount((c) => c + 2), 30);
      } else {
        timer = setTimeout(() => setPhase("analyzing"), 200);
      }
    } else if (phase === "analyzing") {
      timer = setTimeout(() => setPhase("highlighting"), PHASE_DURATION.analyzing);
    } else if (phase === "highlighting") {
      const totalHighlights = ESSAY_SEGMENTS.filter((s) => s.type !== "neutral").length;
      if (highlightedCount < totalHighlights) {
        timer = setTimeout(() => setHighlightedCount((c) => c + 1), 380);
      } else {
        timer = setTimeout(() => setPhase("scoring"), 200);
      }
    } else if (phase === "scoring") {
      if (scoredCount < COMPETENCIES.length) {
        timer = setTimeout(() => setScoredCount((c) => c + 1), 380);
      } else {
        timer = setTimeout(() => setPhase("reveal"), 200);
      }
    } else if (phase === "reveal") {
      timer = setTimeout(() => {
        setPhase("typing");
        setTypedCount(0);
        setHighlightedCount(0);
        setScoredCount(0);
      }, PHASE_DURATION.reveal);
    }

    return () => clearTimeout(timer);
  }, [phase, typedCount, highlightedCount, scoredCount, totalChars]);

  // Texto a exibir: slice da progressÃ£o de digitaÃ§Ã£o
  const displayedText = fullText.slice(0, typedCount);

  // ReconstrÃ³i os segmentos grifados respeitando a posiÃ§Ã£o
  let cursor = 0;
  const renderedSegments: Array<{ segment: typeof ESSAY_SEGMENTS[0]; show: boolean }> = [];
  let highlightIdx = 0;
  for (const seg of ESSAY_SEGMENTS) {
    const segStart = cursor;
    const segEnd = cursor + seg.text.length;
    cursor = segEnd;

    const isTyped = typedCount >= segStart;
    const isNeutral = seg.type === "neutral";
    const isHighlighted = isNeutral || highlightedCount > highlightIdx - (isNeutral ? 0 : 1);
    if (!isNeutral) highlightIdx++;

    if (!isTyped) {
      // Ainda nÃ£o chegou aqui
      renderedSegments.push({ segment: seg, show: false });
      continue;
    }
    if (phase === "typing" || phase === "analyzing") {
      renderedSegments.push({ segment: { ...seg, type: "neutral" }, show: true });
    } else if (phase === "highlighting" || phase === "scoring" || phase === "reveal") {
      const segIndexInNonNeutral = ESSAY_SEGMENTS.slice(0, ESSAY_SEGMENTS.indexOf(seg)).filter(s => s.type !== "neutral").length;
      const visible = seg.type === "neutral" ? true : segIndexInNonNeutral < highlightedCount;
      renderedSegments.push({ segment: seg, show: visible });
    }
  }

  // Calcula progresso de score para barras
  return (
    <div className="relative bg-paper border border-ink-line rounded-lg overflow-hidden">
      {/* Header da "correÃ§Ã£o" */}
      <div className="flex items-center justify-between px-5 py-3 border-b border-ink-line bg-paper-deep/50">
        <div className="flex items-center gap-2.5">
          <span className="font-mono text-[11px] text-ink-muted uppercase tracking-[0.15em]">
            CorreÃ§Ã£o Â· ENEM
          </span>
        </div>
        <AnimatePresence mode="wait">
          {phase === "analyzing" ? (
            <motion.div
              key="analyzing"
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              className="flex items-center gap-2"
            >
              <span className="w-1.5 h-1.5 rounded-full bg-accent animate-pulse" />
              <span className="font-mono text-[11px] text-accent uppercase tracking-[0.15em]">
                Analisando
              </span>
            </motion.div>
          ) : (
            <motion.div
              key="status"
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              className="flex items-center gap-2"
            >
              <span className="w-1.5 h-1.5 rounded-full bg-emerald-600" />
              <span className="font-mono text-[11px] text-ink-muted uppercase tracking-[0.15em]">
                {phase === "typing" ? "Digitando" : "Corrigida"}
              </span>
            </motion.div>
          )}
        </AnimatePresence>
      </div>

      {/* Corpo: texto da redaÃ§Ã£o */}
      <div className="px-5 pt-5 pb-4 min-h-[180px]">
        <p className="text-[15px] leading-[1.75] text-ink-soft">
          {renderedSegments.map((r, i) => {
            if (!r.show) return null;
            const seg = r.segment;
            if (seg.type === "neutral") {
              return <span key={i}>{seg.text}</span>;
            }
            if (seg.type === "ok") {
              return (
                <span
                  key={i}
                  className="grife-good relative"
                  onMouseEnter={() => setActiveTip(i)}
                  onMouseLeave={() => setActiveTip(null)}
                  onFocus={() => setActiveTip(i)}
                  onBlur={() => setActiveTip(null)}
                  tabIndex={0}
                >
                  {seg.text}
                  <AnimatePresence>
                    {activeTip === i && (
                      <motion.span
                        initial={{ opacity: 0, y: -4 }}
                        animate={{ opacity: 1, y: 0 }}
                        exit={{ opacity: 0, y: -4 }}
                        transition={{ duration: 0.15 }}
                        className="absolute left-1/2 -translate-x-1/2 -top-2 z-10 w-56 px-3 py-2 bg-ink text-paper font-sans text-[12px] leading-snug rounded shadow-lg pointer-events-none"
                      >
                        <Check className="w-3 h-3 inline -mt-0.5 mr-1 text-emerald-400" strokeWidth={2.5} />
                        {seg.tip}
                      </motion.span>
                    )}
                  </AnimatePresence>
                </span>
              );
            }
            // fix
            return (
              <span
                key={i}
                className="grife-bad relative"
                onMouseEnter={() => setActiveTip(i)}
                onMouseLeave={() => setActiveTip(null)}
                onFocus={() => setActiveTip(i)}
                onBlur={() => setActiveTip(null)}
                tabIndex={0}
              >
                {seg.text}
                <AnimatePresence>
                  {activeTip === i && (
                    <motion.span
                      initial={{ opacity: 0, y: -4 }}
                      animate={{ opacity: 1, y: 0 }}
                      exit={{ opacity: 0, y: -4 }}
                      transition={{ duration: 0.15 }}
                      className="absolute left-1/2 -translate-x-1/2 -top-2 z-10 w-56 px-3 py-2 bg-ink text-paper font-sans text-[12px] leading-snug rounded shadow-lg pointer-events-none"
                    >
                      <Sparkles className="w-3 h-3 inline -mt-0.5 mr-1 text-accent-light" strokeWidth={2.25} />
                      {seg.tip}
                    </motion.span>
                  )}
                </AnimatePresence>
              </span>
            );
          })}
          {phase === "typing" && (
            <span className="inline-block w-[2px] h-[1.05em] bg-ink align-middle ml-0.5 animate-pulse" />
          )}
        </p>

        {/* Estado "Analisando" com shimmer sobreposto */}
        <AnimatePresence>
          {phase === "analyzing" && (
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              className="mt-4 h-1 rounded shimmer"
            />
          )}
        </AnimatePresence>
      </div>

      {/* RodapÃ©: competÃªncias + nota */}
      <div className="border-t border-ink-line px-5 py-4 bg-paper-deep/30 space-y-2.5">
        <AnimatePresence>
          {(phase === "scoring" || phase === "reveal") && (
            <motion.div
              initial={{ opacity: 0, height: 0 }}
              animate={{ opacity: 1, height: "auto" }}
              exit={{ opacity: 0, height: 0 }}
              transition={{ duration: 0.3 }}
              className="space-y-2.5 overflow-hidden"
            >
              {COMPETENCIES.slice(0, scoredCount).map((comp, idx) => (
                <motion.div
                  key={comp.label}
                  initial={{ opacity: 0, x: -8 }}
                  animate={{ opacity: 1, x: 0 }}
                  transition={{ duration: 0.3, delay: idx * 0.05 }}
                  className="flex items-center gap-3"
                >
                  <span className="font-mono text-[11px] text-ink-muted w-44 shrink-0 truncate">
                    {comp.label}
                  </span>
                  <div className="flex-1 h-1.5 bg-paper-deep rounded-full overflow-hidden">
                    <motion.div
                      className={`h-full ${comp.color} rounded-full`}
                      initial={{ width: 0 }}
                      animate={{ width: `${(comp.score / 200) * 100}%` }}
                      transition={{ duration: 0.7, ease: [0.16, 1, 0.3, 1] as [number, number, number, number] }}
                    />
                  </div>
                  <span className="font-mono text-[11px] text-ink font-semibold w-12 text-right shrink-0">
                    {comp.score}/200
                  </span>
                </motion.div>
              ))}
            </motion.div>
          )}
        </AnimatePresence>

        {/* Nota final */}
        <AnimatePresence>
          {phase === "reveal" && (
            <motion.div
              initial={{ opacity: 0, y: 8 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.5, ease: [0.16, 1, 0.3, 1] as [number, number, number, number] }}
              className="pt-3 mt-1 border-t border-ink-line flex items-center justify-between"
            >
              <div>
                <p className="font-mono text-[10px] text-ink-muted uppercase tracking-[0.15em]">
                  Nota final
                </p>
                <motion.p
                  initial={{ scale: 0.8, opacity: 0 }}
                  animate={{ scale: 1, opacity: 1 }}
                  transition={{ duration: 0.4, ease: [0.16, 1, 0.3, 1] as [number, number, number, number], delay: 0.1 }}
                  className="font-display font-semibold text-3xl text-ink leading-none mt-1"
                >
                  {FINAL_SCORE}
                  <span className="text-base text-ink-muted font-normal">/1000</span>
                </motion.p>
              </div>
              <div className="text-right">
                <p className="font-mono text-[10px] text-ink-muted uppercase tracking-[0.15em]">
                  NÃ­vel
                </p>
                <p className="font-mono text-[11px] font-semibold text-accent bg-accent-light px-2.5 py-1 rounded mt-1 inline-block">
                  IntermediÃ¡rio
                </p>
              </div>
            </motion.div>
          )}
        </AnimatePresence>
      </div>
    </div>
  );
}