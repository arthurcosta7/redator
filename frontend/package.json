    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "axios": "^1.18.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.12.1",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.511.0",
    "next": "^15.5.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-dropzone": "^14.4.1",
