# ═══════════════════════════════════════════════════════════════
# REDATOR — Variáveis de Ambiente do Backend
# ═══════════════════════════════════════════════════════════════
# ⚠️  NUNCA commit o arquivo .env real no git!
# ⚠️  Este arquivo é apenas um EXEMPLO com valores falsos.
# ═══════════════════════════════════════════════════════════════

# ─── Aplicação ────────────────────────────────────────────────
APP_NAME="Redator"
DEBUG=false
ENVIRONMENT=development   # development | staging | production

# ─── SEGURANÇA CRÍTICA ────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=sua_chave_secreta_super_longa_aqui_minimo_64_chars

# Tempo de vida dos tokens
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS (origens permitidas) ────────────────────────────────
# Em desenvolvimento: http://localhost:3000
# Em produção: https://redator.com.br
ALLOWED_ORIGINS=http://localhost:3000

# ─── Banco de Dados PostgreSQL ────────────────────────────────
# Formato: postgresql+asyncpg://usuario:senha@host:porta/banco
DATABASE_URL=postgresql+asyncpg://redator_user:sua_senha@localhost:5432/redator_db

# ─── Redis (cache e rate limiting) ───────────────────────────
REDIS_URL=redis://:sua_senha_redis@localhost:6379/0

# ─── Claude API (Anthropic) ───────────────────────────────────
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# ─── Google Cloud Vision (OCR de fotos) ───────────────────────
# Baixe o arquivo de credenciais em: console.cloud.google.com
GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/credenciais.json

# ─── Stripe (pagamentos) ──────────────────────────────────────
# Obtenha em: https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs dos preços criados no Stripe Dashboard
STRIPE_PRICE_STANDARD=price_...
STRIPE_PRICE_PRO=price_...

# ─── Email (Resend) ───────────────────────────────────────────
# Obtenha em: https://resend.com/
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@redator.com.br
FROM_NAME="Redator"

# ─── URL do frontend (para emails e CORS) ─────────────────────
FRONTEND_URL=http://localhost:3000
