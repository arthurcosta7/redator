# ═══════════════════════════════════════════════════════════════
# REDATOR — Variáveis de Ambiente do Backend
# ═══════════════════════════════════════════════════════════════
# ⚠️  NUNCA commit o arquivo .env real no git!
# ⚠️  Este arquivo é apenas um EXEMPLO com valores falsos.
# ═══════════════════════════════════════════════════════════════

# ─── Aplicação ────────────────────────────────────────────────
APP_NAME="Redator"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development   # development | staging | production
ACCESS_LOG_SUCCESS_SAMPLE_RATE=0.05

# ─── SEGURANÇA CRÍTICA ────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=sua_chave_secreta_super_longa_aqui_minimo_64_chars
# Chave AES-256-GCM separada. Não reutilize SECRET_KEY.
# Gere com: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=
JWT_ALGORITHM=HS256

# Tempo de vida dos tokens
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS (origens permitidas) ────────────────────────────────
# Em desenvolvimento: http://localhost:3000
# Em produção: https://redator.online
# Listas devem usar JSON válido para o pydantic-settings.
ALLOWED_ORIGINS=["http://localhost:3000"]

# ─── Banco de Dados PostgreSQL ────────────────────────────────
# Formato: postgresql+asyncpg://usuario:senha@host:porta/banco
DATABASE_URL=postgresql+asyncpg://redator_user:redator_dev_password@localhost:5433/redator_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800

# ─── Redis (cache e rate limiting) ───────────────────────────
REDIS_URL=redis://:redator_redis_dev@localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_CONNECT_TIMEOUT_SECONDS=2

# ─── OpenAI API — confirme a disponibilidade dos modelos ─────
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Correções usam um único modelo para maximizar cache e medir custo por versão.
OPENAI_CORRECTION_MODEL=gpt-5.6-luna
OPENAI_FREE_MODEL=gpt-5.6-luna
OPENAI_PAID_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=2
ESSAY_CORRECTION_PROMPT_VERSION=v6
# USD por 1 milhão de tokens; atualize quando o preço oficial mudar.
OPENAI_INPUT_PRICE_PER_MILLION=0.20
OPENAI_CACHED_INPUT_PRICE_PER_MILLION=0.02
OPENAI_OUTPUT_PRICE_PER_MILLION=1.20
OPENAI_CACHE_WRITE_MULTIPLIER=1.25

# ─── Workers de correção ─────────────────────────────────────
# Cada job representa uma chamada cara à IA. Aumente somente após medir DB,
# Redis, latência da OpenAI e orçamento.
CORRECTION_WORKER_MAX_JOBS=2
CORRECTION_JOB_TIMEOUT_SECONDS=180
CORRECTION_JOB_MAX_TRIES=3
CORRECTION_JOB_EXPIRES_SECONDS=3600

# ─── Google Cloud Vision (OCR de fotos) ───────────────────────
# Baixe o arquivo de credenciais em: console.cloud.google.com
# Sem credenciais válidas, o backend usa OpenAI Vision como fallback.
GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/credenciais.json
OPENAI_OCR_MODEL=gpt-5.6-luna
OCR_TIMEOUT_SECONDS=30
OCR_MAX_CONCURRENCY=2

# ─── Stripe (pagamentos) ──────────────────────────────────────
# Obtenha em: https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs dos preços criados no Stripe Dashboard
STRIPE_PRICE_STANDARD_MONTHLY=price_...
# Legado: preencher somente enquanto houver assinatura trimestral existente
STRIPE_PRICE_STANDARD_QUARTERLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
# Legado: preencher somente enquanto houver assinatura trimestral existente
STRIPE_PRICE_PRO_QUARTERLY=price_...
# Planos comerciais de professor
STRIPE_PRICE_TEACHER_30_MONTHLY=price_...
STRIPE_PRICE_TEACHER_60_MONTHLY=price_...
STRIPE_PRICE_TEACHER_100_MONTHLY=price_...
# Legado: mantenha somente até migrar assinaturas antigas para Professor 30
STRIPE_PRICE_TEACHER_PACKAGE=

# ─── Limites dos planos ──────────────────────────────────────
PLAN_FREE_MONTHLY_CORRECTIONS=4
PLAN_STANDARD_MONTHLY_CORRECTIONS=12
PLAN_PRO_MONTHLY_CORRECTIONS=30
PLAN_FREE_MONTHLY_SIMULATIONS=1
PLAN_STANDARD_MONTHLY_SIMULATIONS=3
PLAN_PRO_MONTHLY_SIMULATIONS=8

# ─── Uploads ─────────────────────────────────────────────────
MAX_FILE_SIZE_MB=5
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]

# ─── Email (Resend) ───────────────────────────────────────────
# Obtenha em: https://resend.com/
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@redator.online
FROM_NAME="Redator"

# ─── URL do frontend (para emails e CORS) ─────────────────────
FRONTEND_URL=http://localhost:3000
