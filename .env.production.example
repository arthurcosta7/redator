# REDATOR — configuração única da VPS
#
# Copie como `.env` na raiz do repositório e substitua todos os valores
# <PREENCHER>. O mesmo arquivo alimenta o Docker Compose, a API e o worker.
# Nunca versione o `.env` real.

# Docker Compose / PostgreSQL / Redis
POSTGRES_USER=redator
POSTGRES_PASSWORD=<PREENCHER_COM_OPENSSL_RAND_HEX_32>
REDIS_PASSWORD=<PREENCHER_COM_OPENSSL_RAND_HEX_24>

# Aplicação
APP_NAME=Redator
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
ACCESS_LOG_SUCCESS_SAMPLE_RATE=0.05

# Autenticação
SECRET_KEY=<PREENCHER_COM_OPENSSL_RAND_HEX_64>
# Gere em Base64: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=<PREENCHER_COM_CHAVE_BASE64_DE_32_BYTES>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Origens públicas
ALLOWED_ORIGINS=["https://redator.online","https://www.redator.online"]
FRONTEND_URL=https://redator.online

# As URLs abaixo são sobrescritas pelo Compose com as credenciais acima.
# Permanecem aqui para documentar o contrato completo da aplicação.
DATABASE_URL=postgresql+asyncpg://redator:<PREENCHER>@postgres:5432/redator
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
REDIS_URL=redis://:<PREENCHER>@redis:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_CONNECT_TIMEOUT_SECONDS=2

# OpenAI — modelos confirmados no catálogo oficial da Responses API
OPENAI_API_KEY=<PREENCHER_SK_OPENAI>
OPENAI_FREE_MODEL=gpt-5.6-luna
OPENAI_PAID_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=2

# Fila de correções
CORRECTION_WORKER_MAX_JOBS=2
CORRECTION_JOB_TIMEOUT_SECONDS=180
CORRECTION_JOB_MAX_TRIES=3
CORRECTION_JOB_EXPIRES_SECONDS=3600

# OCR — deixe vazio somente se o OCR não fizer parte do lançamento
GOOGLE_APPLICATION_CREDENTIALS=
OCR_TIMEOUT_SECONDS=30
OCR_MAX_CONCURRENCY=2

# Stripe — use chaves de teste no staging e chaves live apenas em produção
STRIPE_SECRET_KEY=<PREENCHER_SK_LIVE_STRIPE>
STRIPE_WEBHOOK_SECRET=<PREENCHER_WHSEC_STRIPE>
STRIPE_PRICE_STANDARD_MONTHLY=<PREENCHER_PRICE_STRIPE>
STRIPE_PRICE_STANDARD_QUARTERLY=<PREENCHER_PRICE_STRIPE>
STRIPE_PRICE_PRO_MONTHLY=<PREENCHER_PRICE_STRIPE>
STRIPE_PRICE_PRO_QUARTERLY=<PREENCHER_PRICE_STRIPE>
STRIPE_PRICE_TEACHER_PACKAGE=<PREENCHER_PRICE_STRIPE>

# Email
RESEND_API_KEY=<PREENCHER_RE_RESEND>
FROM_EMAIL=suporte@redator.online
FROM_NAME=Redator

# Planos e uploads
PLAN_FREE_DAILY_CORRECTIONS=1
PLAN_STANDARD_DAILY_CORRECTIONS=3
PLAN_PRO_DAILY_CORRECTIONS=10
MAX_FILE_SIZE_MB=5
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]
